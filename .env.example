# =====================================================================
# ANAROSA — variáveis de ambiente (EXEMPLO — sem valores reais)
# ---------------------------------------------------------------------
# Copie para `.env` (ignorado pelo Git) apenas para uso local com o
# Supabase CLI (`supabase functions serve --env-file .env`).
# Em produção, cadastre cada valor como SECRET do projeto Supabase
# (`supabase secrets set NOME=valor`). Nunca coloque nada disso no
# frontend (js/, html/).
# =====================================================================

# ---------------------------------------------------------------------
# BLING — aplicativo criado na Central de Extensões (ver docs/BLING_SETUP_MANUAL.md)
# ---------------------------------------------------------------------
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# URL EXATA cadastrada como "Link de redirecionamento" no app Bling.
# Formato esperado: https://<PROJECT_REF>.supabase.co/functions/v1/bling-oauth-callback
BLING_REDIRECT_URI=

# Endpoints oficiais da API v3 (centralizados aqui; só altere se a doc oficial mudar)
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_AUTH_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_TOKEN_URL=https://api.bling.com.br/Api/v3/oauth/token

# Timeout (ms) das chamadas HTTP ao Bling
BLING_REQUEST_TIMEOUT_MS=15000

# Criação de pedidos no Bling. Mantenha "false" até o checkout/pagamento
# estarem definidos e aprovados. Com "false", bling-create-order nunca
# escreve no Bling.
BLING_ORDER_SYNC_ENABLED=false

# ---------------------------------------------------------------------
# SUPABASE — injetadas automaticamente nas Edge Functions em produção.
# Preencha apenas para execução local.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# LOJA / ADMIN
# ---------------------------------------------------------------------
# Origem do site (usada em CORS e no redirect pós-OAuth).
# Produção: https://www.anarosa.com.br
STOREFRONT_URL=http://localhost:5500

# Segredo para ações administrativas (sync manual, conectar Bling).
# Gere um valor longo e aleatório. Enviado no header
# `x-integration-admin-secret`. Nunca embutir no JS publicado.
INTEGRATION_ADMIN_SECRET=

# Página para onde o callback OAuth redireciona ao final (opcional).
# Padrão: ${STOREFRONT_URL}/integration-status.html
OAUTH_SUCCESS_REDIRECT_URL=

# ---------------------------------------------------------------------
# INFINITEPAY — Checkout Integrado (https://www.infinitepay.io/checkout-documentacao)
# ---------------------------------------------------------------------
# Infinite Tag da conta, SEM o "$" (ex.: conta exibe "$maia_14" → use
# apenas "maia_14"). NÃO é uma credencial secreta na documentação
# oficial consultada, mas mantenha centralizada aqui mesmo assim.
INFINITEPAY_HANDLE=

# Endpoint oficial (só altere se a doc oficial mudar).
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io

# URL pública da função infinitepay-webhook. Padrão:
# ${SUPABASE_URL}/functions/v1/infinitepay-webhook
INFINITEPAY_WEBHOOK_URL=

# Página para onde a InfinitePay redireciona o cliente após o pagamento
# (o backend anexa "?token=<public_token>" por pedido). Padrão:
# ${STOREFRONT_URL}/pedido-confirmado.html
INFINITEPAY_REDIRECT_URL=

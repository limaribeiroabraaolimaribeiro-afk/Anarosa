{
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "deno.ns"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 110
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read _tests/",
    "check": "deno check _shared/*.ts */index.ts"
  }
}
